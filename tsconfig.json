{
    "compilerOptions": {
        "target": "es6",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rootDir": ".",
        "outDir": "dist",
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ]
}